# Copy to .env and fill in; .env stays out of Git.

# The site's host name. With "localhost", Caddy makes a certificate from its own local authority.
LIBREEKKLESIA_HOST=localhost

# At least 50 random characters, for example from:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Only for a changed version: where its source code is published (AGPL-3.0, section 13).
LIBREEKKLESIA_SOURCE_URL=
